# ╔══════════════════════════════════════════════════════════════╗
# ║       BACKEND MUHIT O'ZGARUVCHILARI (.env.example)          ║
# ║  Bu fayl namuna — uni .env ga ko'chiring va to'ldiring      ║
# ║  cp .env.example .env                                       ║
# ╚══════════════════════════════════════════════════════════════╝

# ── Ilova ─────────────────────────────────────────────────────
APP_NAME=NavaiTour
# development | production | test
NODE_ENV=development

# ── Server ────────────────────────────────────────────────────
PORT=5000

# ── Ma'lumotlar bazasi ────────────────────────────────────────
# Mahalliy MongoDB:
MONGODB_URI=mongodb://localhost:27017/navaitour
# MongoDB Atlas (cloud):
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/navaitour

# ── JWT Autentifikatsiya ──────────────────────────────────────
# ⚠️  Production'da ALBATTA o'zgartiring!
# Xavfsiz kalit yaratish:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_strong_secret_key_minimum_32_characters_here
# Token amal qilish muddati: 7d | 24h | 30d
JWT_EXPIRES_IN=7d

# ── Frontend manzili (CORS) ───────────────────────────────────
# Development:
CLIENT_URL=http://localhost:5173
# Production:
# CLIENT_URL=https://your-frontend-domain.com
